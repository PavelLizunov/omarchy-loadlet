#!/usr/bin/python3 -I
"""Authenticated IT8613 profiles and timed trials with thermal fallback."""
from contextlib import contextmanager
import json
import fcntl
import os
import pwd
from pathlib import Path
import re
import signal
import socket
import subprocess
import sys
import time

SELF = '/usr/local/lib/loadlet/fan-control'
STATE = Path('/run/loadlet-fans')
PROFILES = Path('/var/lib/loadlet-fans')
PROFILE_UNIT = 'loadlet-fan-profile@{}.service'


def profile_path(channel):
    if not re.fullmatch(r'pwm[2-5]', channel):
        raise ValueError('Invalid IT8613 channel')
    return PROFILES/(channel+'.json')


def read_profile(channel):
    file = profile_path(channel)
    try:
        content = file.read_text()
    except FileNotFoundError:
        return None
    try:
        data = json.loads(content)
        percent = data['percent']
    except (ValueError, KeyError, TypeError):
        raise ValueError('Invalid saved fan output')
    if type(percent) is not int or not 0 <= percent <= 100:
        raise ValueError('Invalid saved fan output')
    return percent


def save_profile(channel, percent):
    if type(percent) is not int or not 0 <= percent <= 100:
        raise ValueError('Invalid saved fan output')
    PROFILES.mkdir(mode=0o700, exist_ok=True)
    st = PROFILES.lstat()
    if PROFILES.is_symlink() or st.st_uid != 0 or st.st_mode & 0o077:
        raise ValueError('Unsafe profile directory')
    file = profile_path(channel)
    temporary = file.with_suffix('.tmp')
    with temporary.open('w') as stream:
        os.fchmod(stream.fileno(), 0o600)
        json.dump({'percent': percent}, stream)
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(temporary, file)


def switching_path(channel):
    if not re.fullmatch(r'pwm[2-5]', channel):
        raise ValueError('Invalid IT8613 channel')
    return STATE / ('.' + channel + '.switching')


@contextmanager
def switching(channel):
    state_path(channel)
    marker = switching_path(channel)
    lock = os.open(STATE/('.'+channel+'.lock'), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        fd = os.open(marker, os.O_CREAT | os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        os.close(fd)
        try:
            yield
        finally:
            marker.unlink(missing_ok=True)
    finally:
        os.close(lock)


def resume_profile(channel):
    if profile_path(channel).exists():
        subprocess.run(['/usr/bin/systemctl', 'start', PROFILE_UNIT.format(channel)],
                       check=True, timeout=15)


def install_profile_unit():
    Path('/etc/systemd/system/loadlet-fan-profile@.service').write_text(
        '[Unit]\nDescription=Loadlet saved fan output for %i\n'
        'After=systemd-modules-load.service\nStartLimitIntervalSec=0\n\n'
        '[Service]\nType=notify\nTimeoutStartSec=10\nExecStart='+SELF+' profile-worker %i\n'
        'ExecStopPost='+SELF+' recover-profile %i\n'
        'Restart=on-failure\nRestartSec=5\nTimeoutStopSec=5\n\n'
        '[Install]\nWantedBy=multi-user.target\n')
    subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=True, timeout=15)


def controller():
    if Path('/sys/class/dmi/id/board_name').read_text().strip() != 'DRFXI':
        raise ValueError('This installed adapter supports DRFXI / IT8613 only')
    for path in Path('/sys/class/hwmon').glob('hwmon*'):
        try:
            if (path/'name').read_text().strip() == 'it8613':
                return path.resolve()
        except OSError:
            continue
    raise ValueError('IT8613 driver is not loaded')


def channel_files(channel):
    if not re.fullmatch(r'pwm[2-5]', channel):
        raise ValueError('Invalid IT8613 channel')
    path = controller()
    pwm, mode = path/channel, path/(channel+'_enable')
    if not pwm.is_file() or not mode.is_file():
        raise ValueError('Channel is unavailable')
    return pwm, mode


def state_path(channel):
    channel_files(channel)
    STATE.mkdir(mode=0o700, exist_ok=True)
    st = STATE.lstat()
    if STATE.is_symlink() or st.st_uid != 0 or st.st_mode & 0o077:
        raise ValueError('Unsafe controller state directory')
    return STATE/(channel+'.json')


def restore(channel):
    file = state_path(channel)
    if not file.exists():
        return
    saved = json.loads(file.read_text())
    pwm, mode = channel_files(channel)
    value, original_mode = int(saved['pwm']), int(saved['mode'])
    if not 0 <= value <= 255 or original_mode not in (0, 1, 2):
        raise ValueError('Invalid saved controller state')
    # IT8613 rejects duty writes in automatic mode. Go through full speed.
    mode.write_text('0')
    mode.write_text('1')
    pwm.write_text(str(value))
    mode.write_text(str(original_mode))
    file.unlink()


def cooling_floor(target):
    """Use full duty on missing CPU telemetry or a hot CPU, rather than a low hold."""
    cpu = []
    for path in Path('/sys/class/hwmon').glob('hwmon*'):
        try:
            if (path/'name').read_text().strip() not in ('k10temp', 'coretemp', 'zenpower'):
                continue
            for sensor in path.glob('temp*_input'):
                value = int(sensor.read_text())
                if 0 < value < 150000:
                    cpu.append(value)
        except (OSError, ValueError):
            continue
    return 255 if not cpu or max(cpu) >= 80000 else target


def worker(channel, percent, minutes, identify=False, persistent=False):
    if identify and cooling_floor(0) != 0:
        raise ValueError("Identification unavailable: CPU is hot or telemetry is missing")
    pwm, mode = channel_files(channel)
    state = state_path(channel)
    if state.exists():
        raise ValueError('A previous override has not been restored')
    identification_lock = None
    if identify:
        identification_lock = os.open(STATE/".identify.lock", os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        fcntl.flock(identification_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    previous = dict(pwm=int(pwm.read_text()), mode=int(mode.read_text()))
    temporary = state.with_name(f'.{state.name}.{os.getpid()}.tmp')
    try:
        with temporary.open('w') as stream:
            os.fchmod(stream.fileno(), 0o600)
            json.dump(previous, stream)
            stream.flush()
            os.fsync(stream.fileno())
        try:
            os.link(temporary, state)
        except FileExistsError:
            raise ValueError('A previous override has not been restored')
    finally:
        if temporary.exists():
            temporary.unlink()
    stopped = False

    def stop(signum, frame):
        nonlocal stopped
        stopped = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        target = round(percent * 255 / 100)
        # Full speed during takeover avoids the driver's automatic-mode EBUSY.
        mode.write_text('0')
        mode.write_text('1')
        if not identify and not persistent:
            saved = read_profile(channel)
            if saved is not None:
                target = max(target, round(saved * 255 / 100))
            target = 255 if previous['mode'] == 0 else max(previous['pwm'], target)
        pwm.write_text(str(cooling_floor(target)))
        if persistent and os.environ.get('NOTIFY_SOCKET'):
            address = os.environ['NOTIFY_SOCKET']
            with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as notifier:
                notifier.connect('\0'+address[1:] if address.startswith('@') else address)
                notifier.sendall(b'READY=1')
        end = None if persistent else time.monotonic() + (5 if identify else minutes*60)
        while not stopped and (end is None or time.monotonic() < end):
            time.sleep(1)
            if not stopped:
                value = cooling_floor(target)
                pwm.write_text(str(value))
                if identify and value != target:
                    break
    finally:
        try:
            restore(channel)
        finally:
            if identification_lock is not None:
                os.close(identification_lock)


def request(args):
    if not (len(args) == 3 and args[0] == 'save' and re.fullmatch(r'pwm[2-5]', args[1])
            and re.fullmatch(r'(?:[0-9]|[1-9][0-9]|100)', args[2])
            or len(args) == 2 and args[0] == 'restore' and re.fullmatch(r'pwm[2-5]', args[1])
            or len(args) == 4 and args[0] == 'boost' and re.fullmatch(r'pwm[2-5]', args[1])
            and args[2] in ('60', '80', '100') and args[3] in ('5', '10', '30')
            or len(args) == 4 and args[0] == 'identify' and re.fullmatch(r'pwm[2-5]', args[1])
            and args[2] in ('0','5','10','20','30','40','50','60','80','100') and args[3] == '5'):
        raise ValueError('Invalid fan request')
    command = [SELF, *args]
    attempted = subprocess.run(['/usr/bin/sudo', '-n', '--', *command],
                               capture_output=True, text=True, timeout=40,
                               env=dict(os.environ, LC_ALL='C'))
    if attempted.returncode == 0:
        print(attempted.stdout, end='')
        return
    if attempted.returncode != 1 or not any(message in attempted.stderr for message in
            ('a password is required', 'not allowed to execute')):
        raise ValueError(attempted.stderr.strip() or 'Fan command failed')
    subprocess.run(['/usr/bin/pkexec', SELF, 'unlock', str(os.getuid())], check=True, timeout=60)
    subprocess.run(['/usr/bin/sudo', '-n', '--', *command], check=True, timeout=40)


def unlock(uid):
    caller = os.environ.get('PKEXEC_UID') or os.environ.get('SUDO_UID')
    if caller != str(uid) or uid <= 0:
        raise PermissionError('Unlock requires authenticated caller identity')
    username = pwd.getpwuid(uid).pw_name
    if not re.fullmatch(r'[a-z_][a-z0-9_-]*', username):
        raise ValueError('Unsupported account name')
    # Sudo enforces this absolute deadline; reboot does not extend the grant.
    from datetime import datetime, timedelta, timezone
    expires = (datetime.now(timezone.utc) + timedelta(hours=24)).strftime('%Y%m%d%H%M%SZ')
    rule = (f'{username} ALL=(root) NOTAFTER={expires} NOPASSWD: '
            + SELF + ' ^boost pwm[2-5] (60|80|100) (5|10|30)$, '
            + SELF + ' ^save pwm[2-5] ([0-9]|[1-9][0-9]|100)$, '
            + SELF + ' ^restore pwm[2-5]$, '
            + SELF + ' ^identify pwm[2-5] (0|5|10|20|30|40|50|60|80|100) 5$, '
            + '/usr/local/lib/loadlet/power-profile ^apply [A-Za-z0-9_=-]+$, '
            + '/usr/local/lib/loadlet/power-profile ^restore$\n')
    import tempfile
    fd, temporary = tempfile.mkstemp(prefix='.loadlet-', dir='/etc/sudoers.d')
    try:
        with os.fdopen(fd, 'w') as stream:
            stream.write(rule)
            os.fchmod(stream.fileno(), 0o440)
        subprocess.run(['/usr/bin/visudo', '-cf', temporary], check=True, timeout=5,
                       stdout=subprocess.DEVNULL)
        os.replace(temporary, '/etc/sudoers.d/60-loadlet-fans-' + str(uid))
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print('Fan controls unlocked for 24 hours')


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == 'request':
        request(sys.argv[2:])
        return
    if os.geteuid() != 0:
        raise PermissionError('System authentication is required')
    if len(sys.argv) == 3 and sys.argv[1] == 'unlock':
        unlock(int(sys.argv[2]))
        return
    if len(sys.argv) < 3:
        raise ValueError('Expected boost/restore, channel, optional percent and minutes')
    action, channel = sys.argv[1:3]
    channel_files(channel)
    unit = 'loadlet-fan-'+channel+'.service'
    profile_unit = PROFILE_UNIT.format(channel)
    if action == 'save' and len(sys.argv) == 4:
        if not re.fullmatch(r'(?:[0-9]|[1-9][0-9]|100)', sys.argv[3]):
            raise ValueError('Expected an integer percentage from 0 to 100')
        percent = int(sys.argv[3])
        install_profile_unit()
        with switching(channel):
            subprocess.run(['/usr/bin/systemctl', 'stop', unit], check=False, timeout=15,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(['/usr/bin/systemctl', 'stop', profile_unit], check=False, timeout=15,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            restore(channel)
            save_profile(channel, percent)
            subprocess.run(['/usr/bin/systemctl', 'enable', '--now', profile_unit], check=True, timeout=15)
        print('saved')
    elif action == 'profile-worker' and len(sys.argv) == 3:
        percent = read_profile(channel)
        if percent is None:
            raise ValueError('Invalid saved fan output')
        worker(channel, percent, 0, persistent=True)
    elif action == 'restore' and len(sys.argv) == 3:
        profile_path(channel).unlink(missing_ok=True)
        subprocess.run(['/usr/bin/systemctl', 'disable', '--now', profile_unit], check=False, timeout=15,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(['/usr/bin/systemctl', 'stop', unit], check=False, timeout=15,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        restore(channel)
        print('restored')
    elif action in ('boost', 'worker', 'identify', 'identify-worker') and len(sys.argv) == 5:
        percent, minutes = int(sys.argv[3]), int(sys.argv[4])
        identifying = action in ('identify', 'identify-worker')
        if (identifying and (percent not in (0,5,10,20,30,40,50,60,80,100) or minutes != 5)
                or not identifying and (percent not in (60, 80, 100) or minutes not in (5, 10, 30))):
            raise ValueError('Unsupported speed or duration')
        if action in ('worker','identify-worker'):
            worker(channel, percent, minutes, identify=identifying)
            return
        with switching(channel):
            subprocess.run(['/usr/bin/systemctl', 'stop', unit], check=False, timeout=15,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            subprocess.run(['/usr/bin/systemctl', 'stop', profile_unit], check=False, timeout=15,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            restore(channel)
            subprocess.run(['/usr/bin/systemd-run', '--quiet', '--collect', '--unit='+unit,
                            '--property=Type=exec', '--property=TimeoutStopSec=5',
                            '--property=RuntimeMaxSec='+str(10 if identifying else minutes*60+15),
                            '--property=ExecStopPost='+SELF+' recover '+channel,
                            SELF, 'identify-worker' if identifying else 'worker', channel, str(percent), str(minutes)], check=True, timeout=15)
        print('boosted')
    elif action in ('recover', 'recover-profile') and len(sys.argv) == 3:
        restore(channel)
        if action == 'recover':
            marker = switching_path(channel)
            try:
                marker_exists = marker.exists()
            except OSError:
                marker_exists = False
            if not marker_exists:
                resume_profile(channel)
    else:
        raise ValueError('Invalid operation')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
