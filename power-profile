#!/usr/bin/python3 -I
"""Apply a validated Loadlet CPU/fan preset through the system-owned adapter."""
import base64
import importlib.machinery
import importlib.util
import json
import fcntl
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

SELF = '/usr/local/lib/loadlet/power-profile'
STORE = Path('/var/lib/loadlet-power')
CPU = Path('/sys/devices/system/cpu')
ACPI = Path('/sys/firmware/acpi')
ACPI_HANDLERS = Path('/sys/class/platform-profile')
PCI_ID = r'[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}[.][0-7]'
BUS = PCI_ID.replace(':', '_').replace('[.]', '_')
HARDWARE = r'hw[.][a-z0-9_-]{1,32}[.][a-z0-9_-]{1,32}[.]pwm([1-9]|1[0-6])'
GPU_CHANNEL = rf'(nv[.]{BUS}([.]fan[0-7])?|amd[.]{BUS}[.]pwm[1-8])'
FANS = '/usr/local/lib/loadlet/fan-control'
AUTO_STATUS = Path('/run/loadlet-auto-game/status.json')


def policies():
    return sorted((CPU/'cpufreq').glob('policy[0-9]*'))


def read(path):
    try:
        return path.read_text().strip()
    except OSError:
        return None


def capabilities():
    rows = []
    for p in policies():
        rows.append({k: read(p/k) for k in ('scaling_driver', 'scaling_governor',
            'scaling_available_governors', 'energy_performance_preference',
            'energy_performance_available_preferences', 'scaling_min_freq',
            'scaling_max_freq', 'cpuinfo_min_freq', 'cpuinfo_max_freq', 'boost')})
    boost = read(CPU/'cpufreq/boost')
    per_policy = {row['boost'] for row in rows if row['boost'] is not None}
    if boost is None and len(per_policy) == 1:
        boost = per_policy.pop()
    return {'policies': rows, 'boost': boost,
            'noTurbo': read(CPU/'intel_pstate/no_turbo'),
            'platformProfile': read(ACPI/'platform_profile'),
            'platformProfileChoices': (read(ACPI/'platform_profile_choices') or '').split()}


def validate(value):
    if not isinstance(value, dict) or set(value) - {'fans', 'cpu', 'gpuFans'}:
        raise ValueError('Invalid profile fields')
    fans, cpu, gpus = value.get('fans', {}), value.get('cpu', {}), value.get('gpuFans', {})
    if not isinstance(fans, dict) or len(fans) > 16 or not isinstance(cpu, dict) or not isinstance(gpus, dict) or len(gpus) > 8:
        raise ValueError('Invalid profile')
    for channel, percent in fans.items():
        if not isinstance(channel, str) or not re.fullmatch(rf'(pwm[2-5]|{HARDWARE})', channel) or type(percent) is not int or not 0 <= percent <= 100:
            raise ValueError('Invalid fan output')
    if set(cpu) - {'boost', 'governor', 'epp', 'maxMHz', 'platformProfile'}:
        raise ValueError('Invalid CPU fields')
    if cpu.get('boost') is not None and type(cpu['boost']) is not bool:
        raise ValueError('Invalid boost state')
    if cpu.get('governor', '') not in ('', 'powersave', 'performance', 'schedutil', 'ondemand', 'conservative'):
        raise ValueError('Invalid governor')
    if cpu.get('epp', '') not in ('', 'performance', 'balance_performance', 'balance_power', 'power', 'default'):
        raise ValueError('Invalid energy preference')
    platform = cpu.get('platformProfile', '')
    if not isinstance(platform, str) or platform and not re.fullmatch(r'[a-zA-Z0-9_-]{1,64}', platform):
        raise ValueError('Invalid ACPI platform profile')
    mhz = cpu.get('maxMHz', 0)
    if type(mhz) is not int or not 0 <= mhz <= 10000:
        raise ValueError('Invalid frequency limit')
    whole, individual = set(), set()
    for bus, percent in gpus.items():
        if (not isinstance(bus, str) or not re.fullmatch(rf'({PCI_ID}|{GPU_CHANNEL})', bus)
                or type(percent) is not int or not 0 <= percent <= 100):
            raise ValueError('Invalid GPU fan output')
        if re.fullmatch(PCI_ID, bus):
            identity = bus.replace(':', '_').replace('.', '_')
        else:
            _, identity, *fan = bus.split('.')
            if fan:
                individual.add(identity)
                continue
        if identity in whole:
            raise ValueError('Duplicate GPU fan output')
        whole.add(identity)
    if whole & individual:
        raise ValueError('Whole-GPU and individual fan outputs overlap')
    return {'fans': fans, 'cpu': cpu, 'gpuFans': gpus}


def atomic(path, value):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    with temporary.open('w') as f:
        os.fchmod(f.fileno(), 0o600)
        json.dump(value, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(temporary, path)
    fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def cpu_snapshot():
    paths = [row/name for row in policies() for name in
             ('scaling_min_freq', 'scaling_max_freq', 'scaling_governor', 'energy_performance_preference', 'boost')]
    paths.extend((CPU/'cpufreq/boost', CPU/'intel_pstate/no_turbo'))
    snapshot = {str(path): value for path in paths if (value := read(path)) is not None}
    platform = read(ACPI/'platform_profile')
    if platform == 'custom':
        for handler in sorted(ACPI_HANDLERS.glob('platform-profile-*/profile')):
            if (value := read(handler)) is not None and value != 'custom':
                snapshot[str(handler)] = value
    elif platform is not None:
        snapshot[str(ACPI/'platform_profile')] = platform
    return snapshot


def restore_cpu(snapshot):
    errors = []

    def write(path, value):
        recover_step(errors, str(path), lambda: path.write_text(value))

    # Restore the platform mode and boost range before restoring frequency caps.
    for path, value in snapshot.items():
        target = Path(path)
        if target.name == 'profile' and target.parent.name.startswith('platform-profile-') and target.exists():
            write(target, value)
    for name in ('platform_profile', 'boost', 'no_turbo'):
        for path, value in snapshot.items():
            if name == 'platform_profile' and value == 'custom':
                continue
            if Path(path).name == name and Path(path).exists():
                write(Path(path), value)
    for row in policies():
        low, high = row/'scaling_min_freq', row/'scaling_max_freq'
        if str(low) in snapshot and str(high) in snapshot:
            write(low, read(row/'cpuinfo_min_freq') or snapshot[str(low)])
            write(high, snapshot[str(high)])
            write(low, snapshot[str(low)])
    for name in ('scaling_governor', 'energy_performance_preference'):
        for path, value in snapshot.items():
            if Path(path).name == name and Path(path).exists():
                write(Path(path), value)
    if errors:
        raise ValueError('CPU restoration incomplete: ' + '; '.join(errors))


def apply_cpu(cpu):
    rows = policies()
    platform = cpu.get('platformProfile')
    if platform and platform not in (read(ACPI/'platform_profile_choices') or '').split():
        raise ValueError('ACPI platform profile unavailable')
    if not rows and (cpu.get('governor') or cpu.get('epp') or cpu.get('boost') is not None or cpu.get('maxMHz')):
        raise ValueError('CPU frequency driver unavailable')
    for row in rows:
        governor = cpu.get('governor', '')
        if governor and governor not in (read(row/'scaling_available_governors') or '').split():
            raise ValueError('CPU governor unavailable')
        mhz = cpu.get('maxMHz', 0)
        if mhz and not int(read(row/'cpuinfo_min_freq') or 0) <= mhz*1000 <= int(read(row/'cpuinfo_max_freq') or 0):
            raise ValueError('CPU frequency limit outside driver range')
    boost = cpu.get('boost')
    boost_files = [row/'boost' for row in rows if (row/'boost').exists()]
    global_boost = CPU/'cpufreq/boost'
    no_turbo = CPU/'intel_pstate/no_turbo'
    if boost is not None and not (boost_files or global_boost.exists() or no_turbo.exists()):
        raise ValueError('Boost control unavailable')
    if platform:
        (ACPI/'platform_profile').write_text(platform)
    if boost is not None:
        if global_boost.exists():
            global_boost.write_text('1' if boost else '0')
        elif no_turbo.exists():
            no_turbo.write_text('0' if boost else '1')
        for path in boost_files:
            path.write_text('1' if boost else '0')
    for row in rows:
        if cpu.get('governor'):
            (row/'scaling_governor').write_text(cpu['governor'])
        if cpu.get('epp'):
            choices = (read(row/'energy_performance_available_preferences') or '').split()
            if cpu['epp'] not in choices:
                raise ValueError('Energy preference unavailable for the selected governor')
            (row/'energy_performance_preference').write_text(cpu['epp'])
        if cpu.get('maxMHz'):
            high = cpu['maxMHz']*1000
            low = min(int(read(row/'scaling_min_freq') or high), high)
            (row/'scaling_min_freq').write_text(str(low))
            (row/'scaling_max_freq').write_text(str(high))


def fan_adapter():
    loader = importlib.machinery.SourceFileLoader('loadlet_fans', FANS)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def gpu_channel(adapter, bus):
    if re.fullmatch(GPU_CHANNEL, bus):
        return bus
    if not re.fullmatch(PCI_ID, bus):
        raise ValueError('Invalid GPU identity')
    slug = bus.replace(':', '_').replace('.', '_')
    hwmons = adapter.amd_hwmon(bus)
    if not hwmons:
        return 'nv.' + slug
    matches = [pwm.name for hwmon in hwmons for pwm in hwmon.glob('pwm[1-8]')
               if (hwmon/(pwm.name+'_enable')).is_file()]
    if len(matches) != 1:
        raise ValueError('AMD GPU requires a specific PWM channel ID')
    return f'amd.{slug}.{matches[0]}'


def gpu_worker(bus, percent):
    adapter = fan_adapter()
    adapter.worker(gpu_channel(adapter, bus), percent, 0, persistent=True, scope='profile-')


def gpu_reset(bus, recover_only=False):
    adapter = fan_adapter()
    adapter.restore(gpu_channel(adapter, bus), reset=not recover_only, scope='profile-')


def stop_gpu(bus):
    unit = 'loadlet-gpu-fan@'+bus+'.service'
    state = subprocess.run(['/usr/bin/systemctl', 'show', '--property=LoadState', '--value', unit],
                           check=False, timeout=15, capture_output=True, text=True)
    if state.stdout.strip() == 'not-found':
        adapter = fan_adapter() if Path(FANS).is_file() else None
        if adapter and any(adapter.STATE.glob('profile-*.json')):
            gpu_reset(bus, recover_only=True)
        return
    subprocess.run(['/usr/bin/systemctl', 'disable', '--now', unit], check=True, timeout=15,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    gpu_reset(bus, recover_only=True)


def recover_step(errors, name, action):
    try:
        action()
        return True
    except Exception as error:
        errors.append(name + ': ' + str(error))
        return False


def run_fan(*args, timeout=45):
    subprocess.run([FANS, *args], check=True, timeout=timeout,
                   env=dict(os.environ, LOADLET_PROFILE_LOCK_OWNER=str(os.getpid())))


def apply(value, boot=False):
    value = validate(value)
    if (STORE/'recovery.json').exists():
        raise ValueError('Previous profile recovery is incomplete; restore original control first')
    original = STORE/'original-cpu.json'
    previous = cpu_snapshot()
    previous_profile = json.loads((STORE/'active.json').read_text()) if (STORE/'active.json').exists() else {}
    previous_gpus, target_gpus = previous_profile.get('gpuFans', {}), value['gpuFans']
    old_units = {bus for bus in previous_gpus if re.fullmatch(PCI_ID, bus)}
    changed_channels = set() if boot else set(value['fans']) | set(previous_profile.get('fans', {}))
    adapter = fan_adapter() if changed_channels or target_gpus or previous_gpus else None
    # Bare PCI IDs retain their template service. Explicit IDs share the saved
    # per-channel services with direct fan control.
    gpu_channels = {bus for bus in previous_gpus.keys() | target_gpus.keys() if re.fullmatch(GPU_CHANNEL, bus)}
    if not boot:
        changed_channels.update(gpu_channels)
    prior_fans = {channel: adapter.read_profile(channel) for channel in changed_channels}
    for bus, percent in target_gpus.items():
        with adapter.backend(gpu_channel(adapter, bus)) as fan:
            fan.target(percent)
    baseline = json.loads(original.read_text()) if original.exists() else {}
    if previous.keys() - baseline.keys() or not original.exists():
        baseline = previous | baseline
        atomic(original, baseline)
    recovery = {'previous': previous_profile, 'target': value, 'cpu': previous,
                'fans': prior_fans, 'errors': []}
    atomic(STORE/'recovery.json', recovery)
    new_units = {bus for bus in target_gpus if re.fullmatch(PCI_ID, bus)}
    try:
        if value['cpu'] or previous_profile.get('cpu'):
            restore_cpu(baseline)
        if value['cpu']:
            apply_cpu(value['cpu'])
        for bus in sorted(old_units | new_units):
            stop_gpu(bus)
        if not boot:
            outputs = value['fans'] | {key: target_gpus[key] for key in gpu_channels & target_gpus.keys()}
            for channel in sorted(changed_channels - outputs.keys()):
                run_fan('restore', channel)
            for channel, percent in outputs.items():
                run_fan('save', channel, str(percent))
        atomic(STORE/'active.json', value)
        for bus in sorted(new_units):
            subprocess.run(['/usr/bin/systemctl', 'enable', '--now', 'loadlet-gpu-fan@'+bus+'.service'], check=True, timeout=15)
    except BaseException as failure:
        errors = []
        recover_step(errors, 'CPU', lambda: restore_cpu(previous))
        for channel, percent in prior_fans.items():
            args = ['restore', channel] if percent is None else ['save', channel, str(percent)]
            recover_step(errors, channel, lambda args=args: run_fan(*args))
        stopped = set()
        for bus in sorted(old_units | new_units):
            if recover_step(errors, bus, lambda bus=bus: stop_gpu(bus)):
                stopped.add(bus)
        saved = recover_step(errors, 'profile state', lambda: atomic(STORE/'active.json', previous_profile)
                             if previous_profile else (STORE/'active.json').unlink(missing_ok=True))
        if saved:
            for bus in old_units & stopped:
                recover_step(errors, bus, lambda bus=bus: subprocess.run(
                    ['/usr/bin/systemctl', 'enable', '--now', 'loadlet-gpu-fan@'+bus+'.service'], check=True, timeout=15))
        if errors:
            recovery['errors'] = errors
            atomic(STORE/'recovery.json', recovery)
            raise ValueError('Profile failed; recovery incomplete: ' + '; '.join(errors)) from failure
        (STORE/'recovery.json').unlink(missing_ok=True)
        raise
    (STORE/'recovery.json').unlink()


def detector():
    loader = importlib.machinery.SourceFileLoader('loadlet_game_detection', str(Path(SELF).with_name('GameDetection.py')))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def auto_status():
    try:
        value = json.loads(AUTO_STATUS.read_text())
        if not isinstance(value, dict) or type(value.get('updated')) not in (int, float):
            raise ValueError('Invalid automation status')
        if not 0 <= time.monotonic() - value['updated'] <= 30:
            return {'enabled': True, 'gaming': None, 'error': 'status_unavailable'}
        return value
    except FileNotFoundError:
        return {'enabled': False, 'gaming': False, 'error': ''}
    except (OSError, ValueError):
        return {'enabled': False, 'gaming': False, 'error': 'status_unavailable'}


def publish_auto(gaming=False, error=''):
    value = {'enabled': True, 'gaming': None if error else gaming, 'error': error,
             'updated': time.monotonic()}
    atomic(AUTO_STATUS, value)
    os.chmod(AUTO_STATUS.parent, 0o755)
    os.chmod(AUTO_STATUS, 0o644)


def auto_worker():
    detection = detector()
    stopped = False
    def stop(*_):
        nonlocal stopped
        stopped = True
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    last_game = 0
    while not stopped:
        try:
            config = json.loads((STORE/'auto.json').read_text())
            games = detection.running_games(config['uid'])
            if games:
                last_game = time.monotonic()
            gaming = bool(games) or last_game > 0 and time.monotonic() - last_game < 15
            lock = os.open(STORE/'.apply.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
            try:
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    time.sleep(1)
                    continue
                # Re-read under the mutation lock; disabling can race detection.
                if not (STORE/'auto.json').exists():
                    break
                config = json.loads((STORE/'auto.json').read_text())
                target = config['game'] if gaming else config['base']
                active = json.loads((STORE/'active.json').read_text()) if (STORE/'active.json').exists() else None
                if active != target:
                    apply(target)
                publish_auto(gaming)
            finally:
                os.close(lock)
        except FileNotFoundError:
            if not (STORE/'auto.json').exists():
                break
            publish_auto(error='automatic_apply_failed')
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            publish_auto(error='automatic_apply_failed')
        for _ in range(5):
            if stopped:
                break
            time.sleep(1)


def configure_auto(payload):
    caller = os.environ.get('SUDO_UID') or os.environ.get('PKEXEC_UID')
    uid = int(caller or 0)
    if uid <= 0:
        raise ValueError('Automatic profiles require an authenticated desktop owner')
    value = json.loads(base64.urlsafe_b64decode(payload))
    if not isinstance(value, dict) or set(value) != {'game', 'base'}:
        raise ValueError('Invalid automatic profile configuration')
    game = validate(value['game'])
    existing = json.loads((STORE/'auto.json').read_text()) if (STORE/'auto.json').exists() else None
    if existing and existing['uid'] != uid:
        raise ValueError('Automatic profiles belong to another account')
    base = validate(value['base'])
    if not base['cpu']:
        raise ValueError('A complete CPU baseline is required for automatic restoration')
    install_units()
    prior = json.loads((STORE/'active.json').read_text()) if (STORE/'active.json').exists() else None
    gaming = bool(detector().running_games(uid))
    target = game if gaming else base
    before_cpu = cpu_snapshot()
    had_original = (STORE/'original-cpu.json').exists()
    explicit_gpu_channels = [ch for ch in target['gpuFans'] if re.fullmatch(GPU_CHANNEL, ch)]
    adapter = fan_adapter() if not prior and (target['fans'] or explicit_gpu_channels) else None
    before_fans = {channel: adapter.read_profile(channel) for channel in target['fans']} if adapter else {}
    before_gpu_fans = {channel: adapter.read_profile(channel) for channel in explicit_gpu_channels} if adapter else {}
    atomic(STORE/'auto.json', {'uid': uid, 'game': game, 'base': base})
    try:
        apply(target)
        subprocess.run(['/usr/bin/systemctl', 'enable', 'loadlet-power-profile.service'], check=True, timeout=15)
        subprocess.run(['/usr/bin/systemctl', 'enable', '--now', 'loadlet-auto-game.service'], check=True, timeout=15)
        publish_auto(gaming)
    except BaseException as failure:
        errors = []
        if existing:
            recover_step(errors, 'automatic configuration', lambda: atomic(STORE/'auto.json', existing))
        else:
            recover_step(errors, 'automatic configuration', lambda: (STORE/'auto.json').unlink(missing_ok=True))
            recover_step(errors, 'automatic service', lambda: subprocess.run(
                ['/usr/bin/systemctl', 'disable', '--now', 'loadlet-auto-game.service'], check=True, timeout=20))
            recover_step(errors, 'automatic status', lambda: AUTO_STATUS.unlink(missing_ok=True))
        if prior:
            recover_step(errors, 'previous profile', lambda: apply(prior))
        else:
            recover_step(errors, 'previous fans', lambda: apply(
                {'cpu': {},
                 'fans': {c: p for c, p in before_fans.items() if p is not None},
                 'gpuFans': {c: p for c, p in before_gpu_fans.items() if p is not None}}))
            recover_step(errors, 'CPU', lambda: restore_cpu(before_cpu))
            if not errors:
                (STORE/'active.json').unlink(missing_ok=True)
                if not had_original:
                    (STORE/'original-cpu.json').unlink(missing_ok=True)
        if errors:
            if not (STORE/'recovery.json').exists():
                atomic(STORE/'recovery.json', {'previous': prior or {}, 'target': target,
                                              'cpu': before_cpu, 'fans': before_fans | before_gpu_fans, 'errors': errors})
            raise ValueError('Automatic setup failed; recovery incomplete: ' + '; '.join(errors)) from failure
        raise


def disable_auto(restore_base=True):
    config = json.loads((STORE/'auto.json').read_text()) if (STORE/'auto.json').exists() else None
    if config:
        subprocess.run(['/usr/bin/systemctl', 'disable', '--now', 'loadlet-auto-game.service'], check=True, timeout=250,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if config:
        if restore_base:
            apply(validate(config['base']))
        (STORE/'auto.json').unlink(missing_ok=True)
    AUTO_STATUS.unlink(missing_ok=True)


def install_units():
    Path('/etc/systemd/system/loadlet-auto-game.service').write_text(
        '[Unit]\nDescription=Loadlet automatic game profile\nAfter=loadlet-power-profile.service\n'
        '\n[Service]\nType=exec\nExecStart='+SELF+' auto-worker\nRestart=on-failure\nRestartSec=5\n'
        'RuntimeDirectory=loadlet-auto-game\nRuntimeDirectoryMode=0755\nTimeoutStopSec=240\n'
        '\n[Install]\nWantedBy=multi-user.target\n')
    Path('/etc/systemd/system/loadlet-power-profile.service').write_text(
        '[Unit]\nDescription=Loadlet selected CPU and fan profile\nAfter=systemd-modules-load.service\n'
        '\n[Service]\nType=oneshot\nExecStart='+SELF+' apply-active\nRemainAfterExit=yes\n'
        '\n[Install]\nWantedBy=multi-user.target\n')
    Path('/etc/systemd/system/loadlet-gpu-fan@.service').write_text(
        '[Unit]\nDescription=Loadlet GPU fan output for %i\nAfter=systemd-modules-load.service\n'
        '\n[Service]\nType=notify\nTimeoutStartSec=10\nExecStart='+SELF+' gpu-worker %i\n'
        'ExecStopPost='+SELF+' gpu-recover %i\nRestart=on-failure\nRestartSec=5\nTimeoutStopSec=5\n'
        '\n[Install]\nWantedBy=multi-user.target\n')
    subprocess.run(['/usr/bin/systemctl', 'daemon-reload'], check=True, timeout=15)


def request_run(command, timeout):
    child = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             text=True, env=dict(os.environ, LC_ALL='C'))
    def cancel(*_):
        child.terminate()
    previous = signal.signal(signal.SIGTERM, cancel)
    try:
        try:
            stdout, stderr = child.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            child.terminate()
            try:
                child.communicate(timeout=60)
            except subprocess.TimeoutExpired:
                child.kill()
                child.communicate()
            raise
        return subprocess.CompletedProcess(command, child.returncode, stdout, stderr)
    finally:
        signal.signal(signal.SIGTERM, previous)


def main():
    args = sys.argv[1:]
    if args == ['status']:
        value = capabilities()
        value['automatic'] = auto_status()
        print(json.dumps(value))
        return
    if args and args[0] == 'request':
        if not (len(args) == 2 and args[1] in ('restore', 'auto-off') or len(args) == 3 and args[1] in ('apply', 'auto-config')
                and len(args[2]) <= 8192 and re.fullmatch(r'[A-Za-z0-9_=-]+', args[2])):
            raise ValueError('Invalid profile request')
        command = [SELF, *args[1:]]
        result = request_run(['/usr/bin/sudo', '-n', '--', *command], 300)
        if result.returncode and ('a password is required' in result.stderr or 'not allowed to execute' in result.stderr):
            request_run(['/usr/bin/pkexec', FANS, 'unlock', str(os.getuid())], 60).check_returncode()
            result = request_run(['/usr/bin/sudo', '-n', '--', *command], 300)
        if result.returncode:
            raise ValueError(result.stderr.strip() or 'Profile command failed')
        if hasattr(result, 'stdout') and result.stdout:
            print(result.stdout, end='')
        return
    if os.geteuid() != 0:
        raise PermissionError('System authentication required')
    STORE.mkdir(mode=0o700, parents=True, exist_ok=True)
    st = STORE.lstat()
    if STORE.is_symlink() or st.st_uid != 0 or st.st_mode & 0o077:
        raise ValueError('Unsafe power profile directory')
    if args and args[0] in ('apply', 'apply-active', 'restore', 'auto-config', 'auto-off'):
        def interrupt(*_):
            signal.signal(signal.SIGTERM, signal.SIG_IGN)
            raise InterruptedError('Profile operation interrupted')
        signal.signal(signal.SIGTERM, interrupt)
        lock = os.open(STORE/'.apply.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
    if args == ['auto-worker']:
        auto_worker()
    elif len(args) == 2 and args[0] == 'auto-config':
        if len(args[1]) > 8192 or not re.fullmatch(r'[A-Za-z0-9_=-]+', args[1]):
            raise ValueError('Invalid automatic profile payload')
        configure_auto(args[1])
    elif args == ['auto-off']:
        disable_auto()
    elif len(args) == 2 and args[0] == 'apply':
        if len(args[1]) > 8192 or not re.fullmatch(r'[A-Za-z0-9_=-]+', args[1]):
            raise ValueError('Invalid encoded profile')
        value = validate(json.loads(base64.urlsafe_b64decode(args[1])))
        disable_auto(restore_base=False)
        install_units()
        apply(value)
        subprocess.run(['/usr/bin/systemctl', 'enable', 'loadlet-power-profile.service'], check=True, timeout=15)
    elif args == ['apply-active']:
        if (STORE/'active.json').exists():
            apply(json.loads((STORE/'active.json').read_text()), boot=True)
    elif len(args) == 2 and args[0] in ('gpu-worker', 'gpu-reset', 'gpu-recover'):
        if not re.fullmatch(rf'({PCI_ID}|{GPU_CHANNEL})', args[1]):
            raise ValueError('Invalid GPU identity')
        if args[0] != 'gpu-worker':
            gpu_reset(args[1], recover_only=args[0] == 'gpu-recover')
        else:
            value = validate(json.loads((STORE/'active.json').read_text()))
            gpu_worker(args[1], value['gpuFans'][args[1]])
    elif args == ['restore']:
        disable_auto(restore_base=False)
        value = json.loads((STORE/'active.json').read_text()) if (STORE/'active.json').exists() else {}
        recovery = json.loads((STORE/'recovery.json').read_text()) if (STORE/'recovery.json').exists() else {}
        profiles = [value, recovery.get('previous', {}), recovery.get('target', {})]
        channels = set(recovery.get('fans', {}))
        buses = set()
        for profile in profiles:
            channels.update(profile.get('fans', {}))
            for bus in profile.get('gpuFans', {}):
                if re.fullmatch(PCI_ID, bus):
                    buses.add(bus)
                else:
                    channels.add(bus)
        errors = []
        for channel in channels:
            recover_step(errors, channel, lambda channel=channel: run_fan('restore', channel, timeout=30))
        for bus in buses:
            recover_step(errors, bus, lambda bus=bus: stop_gpu(bus))
        if (STORE/'original-cpu.json').exists():
            recover_step(errors, 'CPU', lambda: restore_cpu(json.loads((STORE/'original-cpu.json').read_text())))
        if errors:
            raise ValueError('Original control restoration incomplete: ' + '; '.join(errors))
        (STORE/'active.json').unlink(missing_ok=True)
        (STORE/'original-cpu.json').unlink(missing_ok=True)
        (STORE/'recovery.json').unlink(missing_ok=True)
        subprocess.run(['/usr/bin/systemctl', 'disable', 'loadlet-power-profile.service'], check=True, timeout=15)
    else:
        raise ValueError('Invalid profile operation')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
